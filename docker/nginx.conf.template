# PigeonBox 前端容器 nginx 配置
# ${BACKEND_HOST}/${BACKEND_PORT}/${CLIENT_MAX_BODY_SIZE} 由容器启动时
# envsubst 渲染（官方镜像 docker-entrypoint.d 的 templates 机制，仅替换
# 已定义的环境变量，$host/$uri 等 nginx 变量不受影响）。
#
# 规则语义与 hub deploy/nginx/nginx.conf（单容器反代模板）对齐：
#   - 下载/分片/预签名：流式透传（关缓冲 + 长超时）
#   - 其余 API 前缀：反代后端（清单 = vite.config.ts dev proxy + hash 路由
#     页所需 /request /setup + ops 探测路径；/presign 保留兼容旧入口）
#   - /assets/：本地长缓存（构建产物文件名含 hash，内容变更即改名）
#   - 其余路径：本地文件 + SPA 回退（hash 路由，页面路径恒为 /）
#   - client_max_body_size 须 >= server 配置 upload.upload_size（默认 10MB）

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# ── X-Forwarded-Proto 透传（issue #162，2026-11-10 真机复现）────────
# 本容器有两种部署角色，$scheme 的语义完全不同：
#   1) 自己终结 TLS（浏览器 → 本容器）：$scheme == https，天然正确；
#   2) 位于 TLS 反代之后（TLS 终结器 → 本容器 8080 明文）：$scheme == http。
#      旧模板无条件用 $scheme 覆写上游传来的 X-Forwarded-Proto: https
#      ⇒ 后端看到 http ⇒ 会话 cookie 不带 Secure + 分享链接 base 推断成 http
#      （10.10.10.3 升 5.7.0 真机复现：每个部署者都得在宿主侧 docker cp
#        出来 sed 改模板再挂回容器）。
# 修法：上游给了 X-Forwarded-Proto 就透传，没给（或值非法）才回落 $scheme
#      ⇒ 直连部署行为与旧版逐字一致，无上游反代的场景零变化。
#
# 注：envsubst 只替换「已定义的环境变量」，$scheme / $http_x_forwarded_proto /
#     $pb_forwarded_proto 都是 nginx 变量（非环境变量）⇒ 原样保留。
#     故此处一律用 $var 裸变量写法，不要用带花括号的环境变量写法
#     （花括号形式会被 envsubst 当环境变量名而误替换）。
map $http_x_forwarded_proto $pb_forwarded_proto {
    default                    $scheme;   # 无上游断言/值非法 ⇒ 回落本容器视角
    '~*^https(\s*,.*)?$'       https;     # 上游断言 https（含链式 "https,http"）
    '~*^http(\s*,.*)?$'        http;      # 上游断言 http
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # ── 安全响应头（2026-10-05 审计加固）────────────────────────
    # nosniff 防 MIME 嗅探；XFO SAMEORIGIN 防点击劫持；Referrer-Policy
    # 限制外泄取件码 URL。always 修饰使 4xx/5xx 同样携带。
    # 注: nginx add_header 继承规则——location 内出现任意 add_header 时
    # 不再继承上层,故下方 /assets/ 与 SPA 回退 location 内重复声明。
    # CSP: script-src 'self' + 'unsafe-eval'——vue-i18n 运行时消息编译依赖
    # new Function(输入=站点自有语言包,非用户输入;严格无 eval 会使 i18n
    # 全局崩溃白屏,2026-10-05 实测)。style-src unsafe-inline 予 Element
    # Plus;worker-src blob: 予 pdf.js。
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;


    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    # 通用反代头（location 内未覆写即继承）
    # 必须 $http_host 而非 $host：后端按 Host 头推断公开 base（分享链接/预签回调），
    # $host 丢端口，非 80/443 部署推断出的链接端口错（10.10.10.3 真机事故根因）
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $pb_forwarded_proto;
    proxy_http_version 1.1;
    # WebSocket 预留（后端当前无 WS 端点，保留头部无害）
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # ── 流式通道：下载/分片/预签名 ──────────────────────────────
    # 须排在下方通用 API 正则之前：nginx 正则 location 按出现顺序首个命中生效。
    # 关闭缓冲（大文件不过 nginx 缓冲区）、放宽超时（慢速大传输）。
    # ⚠️ proxy_send_timeout/proxy_read_timeout 是**两次 I/O 之间的间隔**超时，
    # 不是整传总时长；client_body_timeout 是**读取客户端请求体两次读之间的间隔**
    # 超时（nginx 默认 60s，是慢速上传更早的杀手）。公网慢速链路实测 ~0.86MB/s
    # （200MB/243s）⇒ 1.35GB 级大文件若按 300s/60s 卡，PUT 必被 nginx 掐断
    # （proxy_send_timeout 触发）⇒ 大文件上传被服务端单方面掐断。
    # 统一放宽到 3600s（与 hub deploy/nginx/nginx.conf 同口径）。
    location ~ ^/(share/download|chunk/|api/v1/presign|anonymous/download) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_buffering off;
        proxy_request_buffering off;   # 上传分片流式转发
        proxy_connect_timeout 15s;
        client_body_timeout 3600s;
        client_body_buffer_size 128k;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;      # 慢速大文件下载/上传；按网络放宽
    }

    # ── 其余 API：反代后端 ─────────────────────────────────────
    # 清单 = vite dev proxy + hash 路由页所需 /request /setup + ops 探测路径
    # (/health /live /ready /readyz /version——反代链路(openresty 等)指 frontend
    #  时监控语义不变;/metrics 不放行,仅限集群内直连后端抓取)
    # qrcode(生成端点)/preview(取件页预览图)/robots.txt(SEO)缺任一会被
    # SPA fallback 吞掉(POST→405/文本→HTML),2026-10-04 生产实测教训。
    location ~ ^/(share|user|admin|chunk|api|anonymous|download|notifies|presign|request|setup|ping|openapi\.json|health|live|ready|readyz|version|qrcode|preview|robots\.txt)(/|$) {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # ── 带哈希的构建产物：本地长缓存 ────────────────────────────
    # ^~ 跳过正则检测，静态资源请求不会误入反代规则。
    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

        try_files $uri =404;
    }

    # ── 其余：本地文件 + SPA 回退 ───────────────────────────────
    # index.html 禁止强缓存（发版后拿到旧页面最常见原因就是这里加了 immutable）
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    }
}
